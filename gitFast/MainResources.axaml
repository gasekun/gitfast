    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
    
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="Root">
                    <!-- Track holds the thumb and handles large step clicks -->
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}"
                           IsDirectionReversed="True">
            
                        <!-- Custom Styled Thumb -->
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{StaticResource slate-700}" 
                                                CornerRadius="4" 
                                                Margin="2"
                                                Transitions="{TemplateBinding Transitions}"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
            
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Visual state when hovering over the overall scroll area -->
        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background" Value="{StaticResource slate-500}"/>
        </Style>
    </ControlTheme>

</ResourceDictionary>